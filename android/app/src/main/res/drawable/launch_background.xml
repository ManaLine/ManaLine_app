<?xml version="1.0" encoding="utf-8"?>
<!-- Circular logo on white splash background. The logo_splash.png must
     be copied from assets/images/logo.png (see copy command in CLAUDE.md
     or run: cp assets/images/logo.png android/app/src/main/res/drawable/logo_splash.png) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/logo_splash" />
    </item>
</layer-list>
