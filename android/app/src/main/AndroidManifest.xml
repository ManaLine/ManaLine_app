<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Every screen in this app talks to Supabase. This was ONLY declared in
         the debug and profile manifests, which Flutter adds for hot reload —
         so debug builds had network and a RELEASE build would have had none
         at all: no login, no data, nothing. Debug hid it completely. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the app tell "no network" apart from "server unreachable", so
         the offline messaging is about the real state and not a guess. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required for LiveFaceCaptureScreen (LR-004 F1 / BR-036, loan issuance BR-081) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- GPS address verification. COARSE as well as FINE because Android 12+
         lets the user grant only approximate location, and the app must still
         work when they do — a coarse fix is reported as "couldn't verify"
         rather than failing outright.

         Deliberately NOT declared: ACCESS_BACKGROUND_LOCATION. Location is
         only ever read while an agent is standing at a customer's door with
         the app open. Asking for background access would be asking for the
         right to follow people around, and Play Store review treats it as a
         high-risk permission requiring separate justification. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Biometric unlock (local_auth). USE_BIOMETRIC covers Android 9+; the
         older USE_FINGERPRINT is what pre-9 handsets check, and this app
         targets cheap Android hardware where those are still in the field. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <application
        android:label="Mana Line"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
